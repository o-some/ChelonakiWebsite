---
import SiteShell from "../layouts/SiteShell.astro";
import { astroRoutes } from "../astroRoutes.js";

export function getStaticPaths() {
  return astroRoutes.map((route) => ({
    params: { path: route.slice(1) },
    props: { route },
  }));
}

const { route } = Astro.props;
---

<SiteShell route={route} />
