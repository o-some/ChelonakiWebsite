---
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/500.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/noto-sans-arabic/400.css";
import "@fontsource/noto-sans-arabic/500.css";
import "@fontsource/noto-sans-arabic/600.css";
import "@fontsource/noto-sans-arabic/700.css";
import "@fontsource/noto-naskh-arabic/400.css";
import "@fontsource/noto-naskh-arabic/500.css";
import "@fontsource/noto-naskh-arabic/600.css";
import { App } from "../App.jsx";
import generatedTranslations from "../translations.generated.js";
import translationPatches from "../translations.patches.js";
import { enabledLocales, getLocale, localizePath } from "../locales.js";
import { buildStructuredData, getPageContent, isLegacyRoute, routeNames, siteOrigin } from "../seoData.js";
import "../styles.css";

const { route = "/", locale = "de" } = Astro.props;
const localeConfig = getLocale(locale);
const dictionary = {
  ...(generatedTranslations[locale] || {}),
  ...(translationPatches[locale] || {}),
};
const translate = (value: string) => dictionary[value] || value;
const page = getPageContent(route);
const pageName = page.name || routeNames[page.canonicalRoute] || "Chelonaki Studio";
const title = route === "/" ? `Chelonaki | ${translate("Aus Ideen werden funktionierende Systeme")}` : `${translate(pageName)} | Chelonaki`;
const description = page.description;
const localizedDescription = translate(description);
const metaDescription = localizedDescription.length > 160
  ? `${localizedDescription.slice(0, 157).replace(/\s+\S*$/, "")}…`
  : localizedDescription;
const canonical = `${siteOrigin}${localizePath(page.canonicalRoute, locale)}`;
const socialImagePath = page.service?.image || "/assets/service-funnel-liquid-glass-v2.webp";
const socialImage = `${siteOrigin}${socialImagePath}`;
const structuredData = buildStructuredData({ route, locale, localeConfig, translate, canonical, title, description: localizedDescription });
const legacy = isLegacyRoute(route);
const localeCodes = enabledLocales.map(({ code, htmlLang, direction, defaultForCountries }) => ({ code, htmlLang, direction, defaultForCountries }));
---

<!doctype html>
<html lang={localeConfig.htmlLang} dir={localeConfig.direction} data-locale={locale} data-font-group={localeConfig.fontGroup}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={metaDescription}
    />
    <meta name="author" content="Chelonaki · Eleftherios Samouladas" />
    <meta name="robots" content={legacy ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <meta name="googlebot" content={legacy ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <meta name="theme-color" content="#f4ecdf" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chelonaki" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={localeConfig.htmlLang.replace("-", "_")} />
    {enabledLocales.filter((item) => item.code !== locale).map((item) => <meta property="og:locale:alternate" content={item.htmlLang.replace("-", "_")} />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={translate(page.service?.imageAlt || pageName)} />
    <link rel="canonical" href={canonical} />
    {
      enabledLocales.map((item) => (
        <link
          rel="alternate"
          hreflang={item.htmlLang}
          href={`${siteOrigin}${localizePath(page.canonicalRoute, item.code)}`}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${localizePath(page.canonicalRoute, "de")}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/png" href="/assets/chelonaki-turtle-mark.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline define:vars={{ localeCodes }}>
      (() => {
        const pathCode = location.pathname.split("/").filter(Boolean)[0]?.toLowerCase();
        const active = localeCodes.find((item) => item.code === pathCode);
        if (active) {
          document.documentElement.lang = active.htmlLang;
          document.documentElement.dir = active.direction;
          return;
        }
        let stored = null;
        try {
          stored = localStorage.getItem("chelonaki-preferred-language");
        } catch {}
        const candidates = [stored, ...(navigator.languages || []), navigator.language]
          .filter(Boolean)
          .map((value) => String(value).toLowerCase().split("-")[0]);
        const browserSelection = candidates.find((code) => localeCodes.some((item) => item.code === code));
        const country = document.querySelector('meta[name="chelonaki-country"]')?.content?.toUpperCase();
        const isCrawler = /bot|crawler|spider|slurp|bingpreview|google-inspectiontool/i.test(navigator.userAgent || "");
        const countrySelection = !isCrawler && country && !["CH", "BE", "CA"].includes(country)
          ? localeCodes.find((item) => item.defaultForCountries.includes(country))?.code
          : null;
        const selected = browserSelection || countrySelection || "de";
        const source = browserSelection ? (stored ? "stored" : "browser") : countrySelection ? "country" : "default";
        try {
          sessionStorage.setItem("chelonaki-auto-language-decision", JSON.stringify({ language: selected, source, browserLanguage: navigator.language || null }));
        } catch {}
        const suffix = location.pathname === "/" ? "" : location.pathname;
        location.replace(`/${selected}${suffix}${location.search}${location.hash}`);
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div id="root">
      <App initialPath={route} initialLocale={locale} client:load />
    </div>
  </body>
</html>
