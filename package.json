{
  "name": "chelonaki-ai-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --force",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/prepare-sites-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:compliance": "node --test tests/compliance.test.mjs",
    "check:release": "npm run check:astro && npm run test:sites && npm run test:compliance && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "astro": "^7.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.3",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.2"
  }
}
